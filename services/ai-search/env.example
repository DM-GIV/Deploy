# Feature flags. All three must be "true" for the service to answer searches; all are false by default.
# SECURITY/LEGAL flags may be set to true only after a documented review and a separate owner release decision.
AI_LOT_SEARCH_ENABLED=false
AI_LOT_SECURITY_APPROVED=false
AI_LOT_LEGAL_APPROVED=false

# CAPTCHA ("Я человек", self-hosted ALTCHA v1). The key is generated on the server (e.g. `openssl rand -hex 32`), kept only in
# the 0600 env file and must differ from the lead-form key. AI_LOT_ALTCHA_REQUIRED=true makes a valid one-time token mandatory.
AI_LOT_ALTCHA_REQUIRED=false
AI_LOT_ALTCHA_HMAC_KEY=
# Core catalogue search (NOT connected in production until the Core API extension is deployed and the network path approved).
# When both are set, searches go to the Core public-search endpoint instead of live web research.
AI_LOT_CORE_URL=
AI_LOT_CORE_TOKEN=
