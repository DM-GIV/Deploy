-- Run ONCE by the Core database owner (psql as the Core superuser). Replace __PASSWORD__ with a generated secret; never commit it.
-- Creates a login that can only SELECT four tables and cannot write even by mistake.
CREATE ROLE torgatlas_public_search LOGIN PASSWORD '__PASSWORD__' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION CONNECTION LIMIT 4;
ALTER ROLE torgatlas_public_search SET default_transaction_read_only = on;
ALTER ROLE torgatlas_public_search SET statement_timeout = '5s';
ALTER ROLE torgatlas_public_search SET idle_in_transaction_session_timeout = '10s';
GRANT CONNECT ON DATABASE data004 TO torgatlas_public_search;
GRANT USAGE ON SCHEMA public TO torgatlas_public_search;
GRANT SELECT ON public.lots, public.auctions, public.lot_source_records, public.price_periods TO torgatlas_public_search;
-- Rollback: DROP OWNED BY torgatlas_public_search; DROP ROLE torgatlas_public_search;
