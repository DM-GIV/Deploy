# EXAMPLE ONLY; real values live in isolated/lead-intake/config/lead.env (0600), never in Git.
DIRECT_LEADS_ENABLED=false
# Set true ONLY after the owner confirms the legal prerequisite (RKN registry covers the enquiry purpose, policy/consent accepted).
DIRECT_LEADS_LEGAL_APPROVED=false
LEAD_ALLOWED_ORIGIN=https://torgatlas.ru
LEAD_CONSENT_VERSION=2026-10-12.2
DATA_DB_PATH=/data/leads.sqlite3
# Generate each with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"  (must differ)
LEAD_HASH_SALT=
ALTCHA_HMAC_KEY=
# Peers allowed to set X-Real-IP (nginx on this host). Docker published port: bridge gateway.
LEAD_TRUSTED_PROXIES=127.0.0.1,::1
# Optional best-effort e-mail notification AFTER durable acceptance. Leave host blank until Selectel mail resource, domain and TLS delivery are verified.
# Selectel: SMTP_HOST=smtp.mail.selcloud.ru, SMTP_PORT=1127 (implicit TLS); fallback 1126 (STARTTLS).
# SMTP_FROM must use a verified sender on torgatlas.ru; credentials must stay only in protected server environment.
# Existing 465 (implicit TLS) and 587 (STARTTLS) providers remain supported.
SMTP_HOST=
SMTP_PORT=1127
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_EMAIL_TO=
# Retention is LEGAL_PENDING; retention.py never runs automatically.
LEAD_RETENTION_DAYS=
LEAD_RETENTION_LEGAL_APPROVED=false
