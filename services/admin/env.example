# EXAMPLE ONLY; real values live in /home/deploy/torgatlas-ops/isolated/admin/config/admin.env (0600), never in Git.
ADMIN_BASE_URL=https://admin.torgatlas.ru
ADMIN_DB_PATH=/data/admin.sqlite3
LEADS_DB_PATH=/leads/leads.sqlite3
ADMIN_REQUIRE_HTTPS=1
# nginx runs with host networking, so the container sees it as the Docker bridge gateway (check: `docker network inspect torgatlas-admin_default` -> Gateway).
# Without the gateway here X-Real-IP is ignored and every client looks like one IP (shared lockout, useless audit).
ADMIN_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,192.168.32.1
# Telegram notifications (owner provides these through the server secret channel; leave empty = queue only, nothing is sent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional egress proxy if direct access to api.telegram.org is not allowed from this host
TELEGRAM_PROXY=
# 1 = also announce leads that existed when the outbox was FIRST started. Only honoured before the first outbox start
# (meta.outbox_started); on this host the outbox already started with an empty token, so existing leads stay 'skipped'.
NOTIFY_EXISTING=0
