# Template only. The real file lives at /home/deploy/torgatlas-ops/isolated/umami/config/umami.env (0600 deploy:deploy), never in Git.
# Generate hex secrets: openssl rand -hex 24 (DB password), openssl rand -hex 32 (APP_SECRET, TWO_FACTOR_ENCRYPTION_KEY).
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=<generated-hex>
DATABASE_URL=postgresql://umami:<generated-hex>@umami-db:5432/umami
APP_SECRET=<generated-hex>
TWO_FACTOR_ENCRYPTION_KEY=<generated-64-hex>
DISABLE_TELEMETRY=1
